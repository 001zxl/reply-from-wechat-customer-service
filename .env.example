# ============ 复制为 .env 后填写。.env 不要提交到 Git ============

# --- 服务自身 ---
APP_TOKEN=请替换为随机字符串
HOST=127.0.0.1
PORT=8787
DB_PATH=data/assistant.db

# --- 大模型 ---
#
# 密钥在这里填；用哪个模型在 config/models.json 里选（或 /desk 上点下拉框）。
# 项目自带了几个预设，填哪个密钥哪个模型就能用：
#
#   DEEPSEEK_API_KEY   → deepseek-flash（默认，快）、deepseek-pro
#   DASHSCOPE_API_KEY  → qwen-plus、qwen-max（阿里云百炼）
#   CUSTOM_API_KEY     → 自建网关 / One-API / vLLM / Ollama 等
#
# 查看当前有哪些模型、哪个能用：
#     ./run.sh models
# 切换：
#     ./run.sh models use deepseek-pro
# 体检（真连一下，交付时先跑这个）：
#     ./run.sh models check

DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
CUSTOM_API_KEY=

# 自建网关需要额外填地址和模型名（在 config/models.json 的 custom 档案里填）

# LLM_BACKEND=mock 表示用离线假模型（不花钱、不联网），只用于跑通流程
LLM_BACKEND=deepseek

# --- 物流查询：快递100 实时查询（企业版） ---
# 留空则自动降级为 mock（本地假数据），只用于联调，绝不对外发送假物流
LOGISTICS_PROVIDER=mock          # mock | kuaidi100 | sto
KD100_CUSTOMER=
KD100_KEY=
# 申通在快递100的编码
KD100_COM=shentong

# 申通开放平台（若网点有月结账号/开放平台权限则优先用这个）
STO_APPKEY=
STO_SECRET=
STO_API_BASE=

# --- 轮询与安全 ---
POLL_INTERVAL_SECONDS=4
# DRY_RUN=1 时只读消息、只出草稿，绝不发送。第一次接真实微信时保持 1。
DRY_RUN=1

# ★★ 微信操作闸。默认 whitelist：
#      - 只有登记在 config/chats.json 里的会话能打开和读取，名单外直接拒绝
#      - 名单内的会话可以随便读，不用每次批
#      - 发送是另一道闸（见下面的 DRY_RUN 和 WECHAT_SEND_ALLOWLIST）
#    改会话名单（一次性操作）：
#         .venv/bin/python bridge/guard.py allow-chat "南京仓-客服小张"
#         .venv/bin/python bridge/guard.py list-chats
#    strict = 每次操作都要你在终端逐条批（只在临时排查时开，日常会很烦）
#    off    = 完全关闭（不推荐）
WECHAT_GUARD=whitelist
# WECHAT_GUARD_WAIT=300

# ★ 发送白名单：默认为空 = 任何消息都不许发出去（硬闸，任何调用路径都绕不过）。
#   只有把会话名写在这里，那个会话才允许被发送。例：
#   WECHAT_SEND_ALLOWLIST=南京仓-客服小张
WECHAT_SEND_ALLOWLIST=

# --- 微信接入通道 ---
# mock           本地回环，零配置，用来先跑通业务逻辑
# macos_wechat   macOS 截屏+OCR（需「辅助功能」+「屏幕录制」两项系统权限）
# windows_wechat Windows 截屏+OCR（⚠️ 尚未在真实 Windows 机器上验证过，
#                先跑 bridge\inspect_wechat_windows.py --check 逐项确认再上生产）
# wecom_kf       企业微信「微信客服」，官方 API，合规，零封号风险（仅支持一对一）
# wcferry_win    PC 微信 Hook，仅微信 3.9.x，非官方，封号风险高，仅限测试
WECHAT_CHANNEL=mock

# 截屏通道要监听哪些会话（逗号分隔）。注意：光写在这里还不够，
# 会话必须同时在 config/chats.json 白名单里 —— 名单外的程序打不开。
# 加白名单推荐用审核台网页上的「扫描微信会话」按钮，或：
#     ./run.sh guard allow-chat "会话名"
WECHAT_MAC_WATCH=
WECHAT_WIN_WATCH=

# 企业微信自建应用
WECOM_CORP_ID=
WECOM_KF_SECRET=                 # 微信客服 Secret
WECOM_CALLBACK_TOKEN=            # 回调 Token
WECOM_ENCODING_AES_KEY=          # 回调 EncodingAESKey（43位）

# --- 安全阈值 ---
# auto 模式下每分钟最多主动发送条数（防刷屏风控）
AUTO_REPLY_MAX_PER_MINUTE=6
# 主动回复前要求的最小消息间隔（秒）
MIN_REPLY_INTERVAL_SECONDS=3
# strict 模式下等待审批的秒数（默认 0 = 不等待直接拒绝）
# WECHAT_GUARD_WAIT=300

# ============ 六项风控（降低被判定为机器行为的概率）============
# 详细说明见 README 的「补充风控」一节。全部有默认值，不改也能跑。

# 1. 夜间静默：这个时段只出草稿不发送。支持跨午夜，例 22:00-08:00
#    ★ 显式设成空 = 关闭这个功能（注意不是"没设置"，是"设成空"）
QUIET_HOURS=22:00-08:00

# 2. 每日自动发送上限（按会话计）
AUTO_REPLY_MAX_PER_DAY=150

# 3. 随机延迟：发送前等一个区间内的随机时长，避免固定节奏
REPLY_DELAY_MIN=1.5
REPLY_DELAY_MAX=5.0

# 4. 相似度拦截：同会话复读 + 跨会话群发双重检测
SIMILAR_REPLY_WINDOW=5
SIMILAR_REPLY_THRESHOLD=0.88

# 5. 异常熔断：连续失败 N 次就暂停该会话一段时间
CIRCUIT_BREAKER_FAILURES=3
CIRCUIT_BREAKER_COOLDOWN_MINUTES=30

# 6. 打字节奏：粘贴完成到点发送之间停一下，停多久跟字数相关
TYPING_SIMULATION=1
